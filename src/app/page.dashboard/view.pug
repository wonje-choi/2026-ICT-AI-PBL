nav(class="sticky top-0 z-20 bg-white border-b border-gray-200")
    div(class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-4")
        div(class="flex items-center justify-between gap-4")
            div
                p(class="text-xs font-semibold text-indigo-600 mb-1") PAPER TO SCRIPT
                h1(class="text-lg font-semibold text-zinc-950") 논문을 넣으면, 대본부터 시작됩니다
            span(class="hidden sm:inline-flex items-center rounded-full px-3 py-1 text-xs font-medium", [ngClass]="isAdmin() ? 'bg-purple-50 text-purple-700' : 'bg-blue-50 text-blue-700'")
                | {{isAdmin() ? '관리자' : '회원'}}

main(class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8")
    div(class="grid grid-cols-1 xl:grid-cols-5 gap-6 items-start")
        section(class="xl:col-span-3 bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden")
            div(class="px-6 py-6 border-b border-gray-100")
                h2(class="text-[15px] font-semibold text-gray-950") 논문 원문 입력
                p(class="mt-1 text-[13px] text-gray-500") URL을 붙여넣거나 파일을 선택하면 편집 가능한 대본 초안을 바로 만듭니다.

            div(class="p-6 space-y-5")
                div(class="inline-flex rounded-xl bg-gray-100 p-1")
                    button(type="button", (click)="setSourceType('url')", class="rounded-lg px-4 py-2 text-[13px] font-semibold transition-colors", [ngClass]="sourceType === 'url' ? 'bg-white text-indigo-700 shadow-sm' : 'text-gray-500'")
                        | 논문 주소
                    button(type="button", (click)="setSourceType('file')", class="rounded-lg px-4 py-2 text-[13px] font-semibold transition-colors", [ngClass]="sourceType === 'file' ? 'bg-white text-indigo-700 shadow-sm' : 'text-gray-500'")
                        | 파일 업로드

                div(*ngIf="sourceType === 'url'")
                    label(class="block text-[13px] font-medium text-gray-700 mb-2") 논문 URL
                    input(type="url", [(ngModel)]="sourceUrl", placeholder="https://doi.org/... 또는 논문 페이지 주소", class="block w-full rounded-xl border border-gray-300 px-4 py-3 text-[13px] text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none")

                div(*ngIf="sourceType === 'file'")
                    label(class="block text-[13px] font-medium text-gray-700 mb-2") 논문 파일
                    label(class="flex min-h-36 cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-gray-300 bg-gray-50 px-6 py-6 text-center hover:border-indigo-400 hover:bg-indigo-50/40 transition-colors")
                        input(type="file", accept=".pdf,.doc,.docx,.hwp,.hwpx,.txt", class="sr-only", (change)="selectFile($event)")
                        svg(xmlns="http://www.w3.org/2000/svg", fill="none", viewBox="0 0 24 24", stroke-width="1.5", stroke="currentColor", class="size-7 text-indigo-500")
                            path(stroke-linecap="round", stroke-linejoin="round", d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5")
                        span(class="mt-2 text-[13px] font-semibold text-gray-800") {{selectedFile?.name || '파일을 선택하거나 이곳에 놓으세요'}}
                        span(class="mt-1 text-xs text-gray-400") PDF, DOCX, HWP, HWPX, TXT

                div
                    label(class="block text-[13px] font-medium text-gray-700 mb-2") 논문 제목
                    input(type="text", [(ngModel)]="paperTitle", placeholder="비워두면 주소 또는 파일명으로 생성합니다", class="block w-full rounded-xl border border-gray-300 px-4 py-3 text-[13px] text-gray-900 placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none")

                div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
                    div
                        label(class="block text-[13px] font-medium text-gray-700 mb-2") 대상 시청자
                        select([(ngModel)]="audience", class="block w-full rounded-xl border border-gray-300 px-4 py-3 text-[13px] text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none")
                            option(value="일반 독자") 일반 독자
                            option(value="전공 입문자") 전공 입문자
                            option(value="연구자") 연구자
                    div
                        label(class="block text-[13px] font-medium text-gray-700 mb-2") 영상 길이
                        select([(ngModel)]="duration", class="block w-full rounded-xl border border-gray-300 px-4 py-3 text-[13px] text-gray-900 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 focus:outline-none")
                            option(value="3분") 3분
                            option(value="5분") 5분
                            option(value="10분") 10분

                div(class="rounded-xl bg-amber-50 border border-amber-200 px-4 py-3")
                    p(class="text-xs leading-5 text-amber-800") 대본 초안은 원문 검증 전 구성안입니다. 사실·수치·인용을 원문과 대조하고, 영상 제작 전 저작권 및 이용 허가를 확인해주세요.

                button(type="button", (click)="prepareScript()", [disabled]="preparing", class="flex w-full items-center justify-center rounded-xl bg-indigo-600 px-4 py-3 text-[13px] font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:cursor-not-allowed disabled:opacity-60")
                    svg(*ngIf="preparing", class="animate-spin size-4 mr-2", viewBox="0 0 24 24")
                        circle(class="opacity-25", cx="12", cy="12", r="10", stroke="currentColor", stroke-width="4", fill="none")
                        path(class="opacity-75", fill="currentColor", d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z")
                    span {{preparing ? '대본 준비 중...' : '대본 초안 만들기'}}

        aside(class="xl:col-span-2 space-y-6")
            section(class="bg-slate-950 rounded-2xl p-6 text-white")
                p(class="text-xs font-semibold text-indigo-300") 작업 흐름
                ol(class="mt-4 space-y-4")
                    li(class="flex gap-3")
                        span(class="flex size-7 shrink-0 items-center justify-center rounded-full bg-indigo-500 text-xs font-bold") 1
                        div
                            p(class="text-[13px] font-semibold") 논문 입력
                            p(class="mt-1 text-xs leading-5 text-slate-400") 주소 또는 파일과 대상 독자를 선택합니다.
                    li(class="flex gap-3")
                        span(class="flex size-7 shrink-0 items-center justify-center rounded-full bg-indigo-500 text-xs font-bold") 2
                        div
                            p(class="text-[13px] font-semibold") 대본 초안
                            p(class="mt-1 text-xs leading-5 text-slate-400") 연구 배경·방법·결과·한계 순서의 초안을 만듭니다.
                    li(class="flex gap-3")
                        span(class="flex size-7 shrink-0 items-center justify-center rounded-full bg-slate-700 text-xs font-bold") 3
                        div
                            p(class="text-[13px] font-semibold") 검토 후 영상 제작
                            p(class="mt-1 text-xs leading-5 text-slate-400") 원문 검수와 저자 허가 승인 후 영상 제작을 진행합니다.

    section(*ngIf="result", class="mt-6 bg-white rounded-2xl border border-indigo-200 shadow-sm overflow-hidden")
        div(class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 px-6 py-5 border-b border-gray-100")
            div
                p(class="text-xs font-semibold text-indigo-600") 대본 초안 생성 완료
                h2(class="mt-1 text-[15px] font-semibold text-gray-950") {{result.title}}
            button(type="button", (click)="openEditor()", class="inline-flex items-center justify-center rounded-xl bg-gray-950 px-4 py-2.5 text-[13px] font-semibold text-white hover:bg-gray-800") 편집 화면에서 계속하기
        div(class="px-6 py-6")
            pre(class="whitespace-pre-wrap font-sans text-[13px] leading-7 text-gray-700") {{result.content}}
